# Configuración de cuenta de Instagram
IG_USERNAME=tu_usuario_de_instagram
IG_PASSWORD=tu_contraseña_de_instagram

# Google AI Studio API Key (para generación de videos/Reels con IA)
GEMINI_API_KEY=tu_api_key_de_gemini

# Google Drive Source Folder
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1e8l8vqrS6fdYOvhWEzRSLhOyCr5vAGR1

# Archivo de sesión para evitar pedir login en cada subida
IG_SESSION_FILE=session.json

# Intervalo entre publicaciones en minutos
POSTING_INTERVAL_MINUTES=20

# Intervalo de sincronización con Google Drive en horas
SYNC_INTERVAL_HOURS=6

# Modo de prueba por defecto
DRY_RUN=True
